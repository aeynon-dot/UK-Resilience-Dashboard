{
  "version": "1.0.0",
  "name": "Resilience Monitor Source / Feed Registry",
  "purpose": "Machine-readable inventory of external sources used to collect or support disruptive-risk intelligence.",
  "design_principles": [
    "Every automated feed has a stable identifier.",
    "The registry records provenance, ownership, update method and expected freshness.",
    "A feed is not trusted merely because it is listed; collection and validation status are runtime properties.",
    "Source content is untrusted input and must be validated and safely rendered.",
    "Organisational/private data sources are out of scope for the public MVP."
  ],
  "sources": [
    {
      "id": "met-office-severe-weather-warnings",
      "name": "Met Office Severe Weather Warnings",
      "publisher": "Met Office",
      "authority_type": "national_meteorological_service",
      "source_type": "warning_feed",
      "transport": "rss",
      "endpoint": "https://www.metoffice.gov.uk/public/data/PWSCache/WarningsRSS/Region/UK",
      "landing_url": "https://weather.metoffice.gov.uk/warnings-and-advice/uk-warnings",
      "risk_themes": ["natural_and_environmental_hazards"],
      "risk_domains": ["climate_and_weather"],
      "geographies": ["UK", "England", "Wales", "Scotland", "Northern Ireland"],
      "expected_update_minutes": 15,
      "freshness_tolerance_minutes": 30,
      "enabled": true,
      "public": true,
      "notes": "Primary severe-weather warning source used by the current dashboard."
    },
    {
      "id": "environment-agency-flood-monitoring",
      "name": "Environment Agency Flood Monitoring",
      "publisher": "Environment Agency",
      "authority_type": "national_environment_agency",
      "source_type": "live_api",
      "transport": "https",
      "endpoint": "https://environment.data.gov.uk/flood-monitoring/id/floods",
      "landing_url": "https://check-for-flooding.service.gov.uk/",
      "risk_themes": ["natural_and_environmental_hazards"],
      "risk_domains": ["flooding"],
      "geographies": ["England"],
      "expected_update_minutes": 15,
      "freshness_tolerance_minutes": 30,
      "enabled": true,
      "public": true,
      "notes": "Live flood monitoring data. Temporary upstream failures should retain the last usable snapshot."
    },
    {
      "id": "natural-resources-wales-flood-warning",
      "name": "Natural Resources Wales Flood Warning",
      "publisher": "Natural Resources Wales",
      "authority_type": "national_environment_agency",
      "source_type": "web_feed",
      "transport": "https",
      "endpoint": "https://flood-warning.naturalresources.wales/AToZ",
      "landing_url": "https://flood-warning.naturalresources.wales/",
      "risk_themes": ["natural_and_environmental_hazards"],
      "risk_domains": ["flooding"],
      "geographies": ["Wales"],
      "expected_update_minutes": 15,
      "freshness_tolerance_minutes": 30,
      "enabled": true,
      "public": true,
      "notes": "Current MVP collection derives counts from the public flood-warning service."
    },
    {
      "id": "sepa-flooding",
      "name": "SEPA Flooding",
      "publisher": "Scottish Environment Protection Agency",
      "authority_type": "national_environment_agency",
      "source_type": "web_feed",
      "transport": "https",
      "endpoint": "https://beta.sepa.scot/flooding",
      "landing_url": "https://beta.sepa.scot/flooding",
      "risk_themes": ["natural_and_environmental_hazards"],
      "risk_domains": ["flooding"],
      "geographies": ["Scotland"],
      "expected_update_minutes": 15,
      "freshness_tolerance_minutes": 30,
      "enabled": true,
      "public": true,
      "notes": "Current MVP collection derives flood activity from the public SEPA flooding service."
    },
    {
      "id": "dfe-rivers-northern-ireland",
      "name": "DfI Rivers",
      "publisher": "Department for Infrastructure Northern Ireland",
      "authority_type": "government_department",
      "source_type": "reference_only",
      "transport": "web",
      "endpoint": null,
      "landing_url": "https://www.infrastructure-ni.gov.uk/topics/rivers",
      "risk_themes": ["natural_and_environmental_hazards"],
      "risk_domains": ["flooding"],
      "geographies": ["Northern Ireland"],
      "expected_update_minutes": null,
      "freshness_tolerance_minutes": null,
      "enabled": true,
      "public": true,
      "notes": "Reference source pending a suitable automated live feed."
    }
  ]
}
