{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeynon-dot.github.io/UK-Resilience-Dashboard/schemas/source-registry.schema.json",
  "title": "Resilience Monitor Source Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version","name","sources"],
  "properties": {
    "version": {"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
    "name": {"type":"string","minLength":2},
    "sources": {
      "type":"array",
      "items":{"$ref":"#/$defs/source"},
      "uniqueItems":true
    }
  },
  "$defs": {
    "source": {
      "type":"object",
      "additionalProperties":false,
      "required":["id","name","publisher","authority_type","source_type","transport","landing_url","risk_themes","risk_domains","geographies","enabled","public"],
      "properties":{
        "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,99}$"},
        "name":{"type":"string","minLength":2,"maxLength":200},
        "publisher":{"type":"string","minLength":2,"maxLength":200},
        "authority_type":{"type":"string","minLength":2,"maxLength":100},
        "source_type":{"type":"string","enum":["warning_feed","live_api","web_feed","dataset","bulletin","reference_only","other"]},
        "transport":{"type":"string","enum":["https","rss","atom","api","web","file","other"]},
        "endpoint":{"type":["string","null"],"format":"uri","maxLength":2000},
        "landing_url":{"type":"string","format":"uri","maxLength":2000},
        "risk_themes":{"type":"array","items":{"type":"string"},"minItems":1,"uniqueItems":true},
        "risk_domains":{"type":"array","items":{"type":"string"},"minItems":1,"uniqueItems":true},
        "geographies":{"type":"array","items":{"type":"string"},"minItems":1,"uniqueItems":true},
        "expected_update_minutes":{"type":["integer","null"],"minimum":1},
        "freshness_tolerance_minutes":{"type":["integer","null"],"minimum":1},
        "enabled":{"type":"boolean"},
        "public":{"type":"boolean"},
        "notes":{"type":"string","maxLength":2000}
      }
    }
  }
}
