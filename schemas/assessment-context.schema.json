{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uk-resilience-monitor.pages.dev/schemas/assessment-context.schema.json",
  "title": "Resilience Monitor Assessment Context",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessment_id","timestamp","monitoring_scope","signals","relationships","data_quality"],
  "properties": {
    "assessment_id": {"type":"string","minLength":1},
    "timestamp": {"type":"string","format":"date-time"},
    "monitoring_scope": {"type":"object","additionalProperties":false,"required":["geography","domains","filters"],"properties":{"geography":{"type":"string","minLength":1},"domains":{"type":"array","items":{"type":"string"},"uniqueItems":true},"filters":{"type":"object"}}},
    "signals": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["signal_id","title","description","domain","hazard","geography","severity","status","published_at","updated_at","change_status","source","authoritative_source","evidence_confidence"],"properties":{"signal_id":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},"description":{"type":"string"},"domain":{"type":"string"},"hazard":{"type":"string"},"geography":{"type":"object"},"severity":{"type":"string"},"status":{"type":"string"},"published_at":{"type":["string","null"],"format":"date-time"},"updated_at":{"type":["string","null"],"format":"date-time"},"change_status":{"type":"string","enum":["new","changed","unchanged","resolved","unknown"]},"source":{"type":"string"},"authoritative_source":{"type":"boolean"},"evidence_confidence":{"type":"string"}}}},
    "relationships": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["signal_ids","relationship_type","supporting_evidence"],"properties":{"signal_ids":{"type":"array","items":{"type":"string"},"minItems":2,"uniqueItems":true},"relationship_type":{"type":"string"},"supporting_evidence":{"type":"array","items":{"type":"string"}}}}},
    "data_quality": {"type":"object","additionalProperties":false,"required":["stale_sources","failed_sources","limitations"],"properties":{"stale_sources":{"type":"array","items":{"type":"string"}},"failed_sources":{"type":"array","items":{"type":"string"}},"limitations":{"type":"array","items":{"type":"string"}}}}
  }
}